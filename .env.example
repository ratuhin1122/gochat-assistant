# ── Server Configuration ────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── LLM Provider Configuration ────────────────────────────────────────────────
# Supported options: gemini | ollama | none
LLM_PROVIDER=none

# Gemini Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (used if LLM_PROVIDER=ollama)
# - When running the app locally on host: http://localhost:11434
# - When running via Docker Compose with the local-llm profile: http://ollama:11434
# To start with Ollama in Docker: docker compose --profile local-llm up --build
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Database Configuration ─────────────────────────────────────────────────────
# - When running the app locally on host with DB container: postgres://postgres:postgres@localhost:5432/gochat?sslmode=disable
# - When running the full stack via Docker Compose: postgres://postgres:postgres@db:5432/gochat?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gochat?sslmode=disable

# PostgreSQL Docker Container Environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gochat
POSTGRES_PORT=5432

# ── Observability Configuration (Optional) ─────────────────────────────────────
# OpenTelemetry OTLP trace exporter endpoint (e.g. localhost:4318 or http://collector:4318).
# If unset, OpenTelemetry runs in no-op mode without an exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=
