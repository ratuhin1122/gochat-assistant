# ── Server Configuration ────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── LLM Provider Configuration ────────────────────────────────────────────────
# Supported options: gemini | ollama | none
LLM_PROVIDER=none

# Gemini Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (used if LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Database Configuration ─────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gochat?sslmode=disable

# PostgreSQL Docker Container Environment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gochat
POSTGRES_PORT=5432
